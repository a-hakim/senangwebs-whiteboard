{
  "name": "senangwebs-whiteboard",
  "version": "1.2.0",
  "description": "A powerful, client-side JavaScript drawing library for creating digital whiteboards and vector drawings.",
  "main": "dist/sww.js",
  "module": "dist/sww.esm.mjs",
  "style": "dist/sww.css",
  "exports": {
    ".": {
      "import": "./dist/sww.esm.mjs",
      "require": "./dist/sww.js",
      "default": "./dist/sww.js"
    },
    "./dist/sww.css": "./dist/sww.css",
    "./dist/sww.min.css": "./dist/sww.min.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "node scripts/check-package.js && node scripts/test-core.js",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch"
  },
  "dependencies": {
    "@bookklik/senangstart-icons": "^1.0.7",
    "marked": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "babel-loader": "^9.0.0",
    "css-loader": "^6.0.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "file-loader": "^6.2.0",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.0.0",
    "style-loader": "^3.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "whiteboard",
    "drawing",
    "canvas",
    "javascript",
    "library",
    "vector",
    "graphics",
    "digital",
    "sketch",
    "paint"
  ],
  "author": "a-hakim",
  "license": "MIT",
  "directories": {
    "example": "examples"
  }
}
